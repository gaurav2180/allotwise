PORT=3000
NODE_ENV=development

# REQUIRED in production. Used to HMAC PANs for cache + rate-limit keys.
# Raw PANs are never used as keys and never persisted. Rotate to invalidate all cached results.
PAN_HASH_SECRET=change-me-to-a-long-random-string

# Shared with the frontend so the backend can tell its own proxy from a direct
# caller. Without it the backend believes X-Forwarded-For from anyone, and the
# per-IP limits (including the distinct-PAN guard) can be walked past by
# changing that header on every request. Set the SAME value on both services.
PROXY_SHARED_SECRET=change-me-to-a-long-random-string

DB_PATH=./data/allotwise.db

# Upstream (KFintech)
KFINTECH_API_BASE=https://0uz601ms56.execute-api.ap-south-1.amazonaws.com/prod/api/query
KFINTECH_BUNDLE_INDEX=https://ipostatus.kfintech.com/
KFINTECH_TIMEOUT_MS=8000
KFINTECH_MAX_RETRIES=3
KFINTECH_MAX_CONCURRENCY=4

# Upstream (Link Intime / MUFG Intime)
LINKINTIME_API_BASE=https://in.mpms.mufg.com/Initial_Offer
LINKINTIME_TIMEOUT_MS=8000
LINKINTIME_MAX_RETRIES=3
LINKINTIME_MAX_CONCURRENCY=4

# Bigshare (deep-link only: captcha enforced). Doubles as the seeding source.
BIGSHARE_STATUS_PAGE=https://ipo.bigshareonline.com/ipo_status.html

# GMP + calendar source (scraped public pages, not APIs).
# ONE on purpose. Two trackers name the same company differently -- "NSE" vs
# "National Stock Exchange of India" -- and those share no slug and no name
# token, so the IPO appears twice and nothing downstream can reconcile it.
# Adding a second here brings the duplicates back. Rows from a source that is
# no longer listed are dropped from the database on the next start.
GMP_SOURCES=ipoji
GMP_TIMEOUT_MS=20000
# Sites sit behind Cloudflare, which serves empty bodies to non-browser UAs.
GMP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36
# Max detail pages fetched per metadata sync (bounds load).
GMP_DETAIL_FETCH_LIMIT=24

# NSE (official metadata + subscription). Mainboard only.
NSE_API_BASE=https://www.nseindia.com/api
NSE_HOMEPAGE=https://www.nseindia.com/market-data/all-upcoming-issues-ipo
NSE_TIMEOUT_MS=15000

# Scheduler: run the sync jobs from inside the server process.
# Off by default -- prefer running `npm run scheduler` as a separate process.
SCHEDULER_ENABLED=false
SCHEDULER_RUN_ON_START=true
SCHEDULER_REGISTRARS_MS=3600000
SCHEDULER_GMP_MS=1800000
SCHEDULER_SUBSCRIPTION_MS=1200000

# Cache TTLs (seconds)
CACHE_TTL_FINALIZED=604800
CACHE_TTL_PENDING=120
CACHE_TTL_NOT_FOUND=300
CACHE_MAX_ENTRIES=20000

# Rate limits
RL_GLOBAL_WINDOW_MS=900000
RL_GLOBAL_MAX=200
RL_ALLOTMENT_WINDOW_MS=900000
RL_ALLOTMENT_MAX=20
RL_PAN_WINDOW_MS=3600000
RL_PAN_MAX=30
RL_DISTINCT_PAN_WINDOW_MS=3600000
RL_DISTINCT_PAN_MAX=10
