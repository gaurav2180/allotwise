# Where the Express backend lives. Defaults to localhost for local dev;
# override in a deployed environment to point at the backend's own address.
BACKEND_URL=http://localhost:3000

# Must match PROXY_SHARED_SECRET in the backend's own .env, exactly. Lets the
# backend tell this proxy from a direct caller, so its per-IP rate limits key
# off the real visitor instead of collapsing into one bucket keyed off this
# server's own IP. Optional locally; effectively required in production.
PROXY_SHARED_SECRET=

# Waitlist signup notifications (lib/mail.ts).
#
# Sent via Gmail SMTP using an App Password, not the account's real password —
# Google rejects plain-password SMTP login outright. To get one:
#   1. Turn on 2-Step Verification on the allotwise@gmail.com account:
#      https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords, create one named
#      "Allotwise", and copy the 16-character password it generates.
#   3. Paste it below (in .env.local, not this file) with no spaces.
GMAIL_USER=allotwise@gmail.com
GMAIL_APP_PASSWORD=
