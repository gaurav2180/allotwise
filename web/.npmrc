# Install devDependencies even when NODE_ENV=production.
#
# The deployment sets NODE_ENV=production, which makes npm omit devDependencies
# — but the *build* needs several of them: @tailwindcss/postcss compiles
# globals.css, and typescript compiles the app. Without this, `npm ci` installs
# 105 packages instead of 486 and `next build` fails with
# "Cannot find module '@tailwindcss/postcss'".
#
# This was latent for a long time. The lockfile predated those packages moving
# into devDependencies and so did not flag them `dev`, which meant they were
# installed anyway; the first regeneration of the lockfile marked them correctly
# and the build broke. `include` wins over `omit` regardless of order, which is
# what makes this the fix rather than a race.
include=dev
